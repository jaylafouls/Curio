{
  "manifest_version": 3,
  "name": "Curio — Save a link",
  "version": "1.0.0",
  "description": "Save the page you're on to Curio — pick a collection, add a note, done.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "Save to Curio",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": ["activeTab", "storage"],
  "host_permissions": [
    "https://curio-neon.vercel.app/*",
    "http://localhost:3000/*"
  ]
}
